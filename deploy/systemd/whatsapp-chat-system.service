[Unit]
Description=WhatsApp Chat System standalone API (single-process, also serves frontend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=whatsapp-chat-system
Group=whatsapp-chat-system
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
WorkingDirectory=/opt/whatsapp-chat-system
EnvironmentFile=-/etc/whatsapp-chat-system/api.env
# Required from api.env:
#   DATABASE_URL                  (sqlite:////abs/path/app.db 或 postgresql://...)
#   WHATSAPP_BRIDGE_INTERNAL_TOKEN
# Strongly recommended:
#   WHATSAPP_BRIDGE_HMAC_SECRET   (须与 bridge.env 中同名变量一致)
#   AI_SECRET_ENCRYPTION_KEY      (生产必须显式设置并备份)
#   CHAT_SYSTEM_ALLOWED_ORIGINS   (前后端同源时可省略)
# First boot only:
#   CHAT_SYSTEM_BOOTSTRAP_PASSWORD (至少 12 位，初始化完成后可移除)
Environment=CHAT_SYSTEM_RUNTIME_DIR=/var/lib/whatsapp-chat-system/api
Environment=CHAT_SYSTEM_WEB_DIST=/opt/whatsapp-chat-system/web/dist
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/whatsapp-chat-system/.venv/bin/python -m whatsapp_chat_system.cli serve --host 127.0.0.1 --port 8792 --web-dist /opt/whatsapp-chat-system/web/dist
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
