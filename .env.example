# WhatsApp Chat System — 后端环境变量参考
#
# 复制为 .env 后按需修改：
#     cp .env.example .env
# 直接 `python scripts/run_server.py` 启动时会自动载入。
#
# 注意：已存在于进程环境中的变量优先于本文件，因此 systemd /
# Windows 服务 / 平台面板里注入的配置不会被本地文件覆盖。

# ---------------------------------------------------------------- 必填

# Bridge（Node.js）与 API 之间的内部事件接口共享令牌。
# 缺失时内部事件接口会以 503 拒绝所有请求。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_BRIDGE_INTERNAL_TOKEN=change-me-to-a-long-random-value

# ---------------------------------------------------------------- 建议配置

# 内部事件接口的 HMAC 签名密钥（推荐开启）。
# 开启后，除静态 token 外还会校验 HMAC-SHA256 签名、时间戳窗口与 nonce，
# 从而拦截 token 泄露后的伪造注入与抓包重放。
# 必须与 WHATSAPP_BRIDGE_INTERNAL_TOKEN 不同。
# 留空则退回「仅静态 token」的旧行为（启动日志会给出告警）。
WHATSAPP_BRIDGE_HMAC_SECRET=

# 数据库连接串。两套后端都受支持，且 postgres:// 与 postgresql:// 会自动归一：
#
#   SQLite（默认，单机/小规模）：
#     DATABASE_URL=sqlite:////var/lib/whatsapp-chat-system/app.db
#   PostgreSQL（推荐用于服务器、多进程部署）：
#     DATABASE_URL=postgresql://user:password@127.0.0.1:5432/whatsapp_chat
#
# 留空时默认使用 <仓库根>/data/whatsapp-chat-system.db（绝对路径）。
DATABASE_URL=

# 运行目录：存放 web-settings.json、密钥文件、翻译记忆库等可变状态。
# 留空时默认使用 <仓库根>/.runtime。
CHAT_SYSTEM_RUNTIME_DIR=

# 允许跨域访问 API 的浏览器来源，逗号分隔。
# 前后端分开部署时**必须**把前端域名加进来，否则浏览器会拦截请求。
# 通配符 * 会被显式拒绝（控制台携带操作员会话令牌）。
# 示例：
#   CHAT_SYSTEM_ALLOWED_ORIGINS=https://console.example.com,http://localhost:5173
CHAT_SYSTEM_ALLOWED_ORIGINS=

# ---------------------------------------------------------------- AI 能力

# 问鼎 AI 接入点与密钥。密钥会以 Fernet 认证加密后入库，
# 因此务必保证主密钥安全（见下方 AI_SECRET_ENCRYPTION_KEY）。
WENDING_AI_BASE_URL=https://wendingai.future1.us/v1
WENDING_AI_API_KEY=
WENDING_AI_DEFAULT_MODEL=gpt-5.3-codex-spark
WENDING_AI_TIMEOUT_SECONDS=90
WENDING_AI_MAX_RETRIES=2

# API 密钥的加密主密钥。**生产环境必须显式设置并妥善备份**：
# 一旦丢失，库中已加密的 AI 密钥将无法解密。
# 用 Secret Manager / 平台环境变量注入，不要提交进版本库。
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_SECRET_ENCRYPTION_KEY=
# 也可改为从文件读取主密钥（适合挂载 Secret 卷的场景）：
AI_SECRET_ENCRYPTION_KEY_FILE=

# 首次启动的管理员密码。仅在初始化运行时配置时使用。
CHAT_SYSTEM_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------- Bridge 与监听

# Bridge V2 地址（API 通过它发送 WhatsApp 消息）
WHATSAPP_BRIDGE_V2_URL=http://127.0.0.1:3100

# API 监听地址与端口（也可用命令行 --host / --port 覆盖）
CHAT_SYSTEM_HOST=0.0.0.0
CHAT_SYSTEM_PORT=8792

# 可选：已构建的前端目录。
# 不设置时后端为「纯 API 模式」，前端独立部署并通过 VITE_API_BASE 指向本服务；
# 设置后为「单进程模式」，由后端同时托管前端静态文件。
CHAT_SYSTEM_WEB_DIST=
