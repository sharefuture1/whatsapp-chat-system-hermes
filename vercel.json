{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": { "deploymentEnabled": false },
  "installCommand": "npm ci --prefix web",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
